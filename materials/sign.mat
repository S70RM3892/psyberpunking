// ネオン看板の発光面。文字は使わず幾何模様（仕様：実ゲームのロゴ・名称は使わない）。
// custom0.x = 縦横比（幅/高さ）。色・パターンはマテリアルインスタンスごとに設定する。
material {
    name : sign,
    shadingModel : unlit,
    requires : [ uv0, custom0 ],
    parameters : [
        { type : float3, name : color },
        { type : float, name : pattern },
        { type : float, name : seed },
        { type : float, name : nits },
        { type : float, name : time }
    ],
    variables : [ attrs ],
    culling : back,
    variantFilter : [ skinning, shadowReceiver ]
}

vertex {
    void materialVertex(inout MaterialVertexInputs material) {
        material.attrs = getCustom0();
    }
}

fragment {
    #include "common.glsl"

    // 管の太さ w の線（距離 d）を光らせる。芯は白っぽく、周りは色
    float tube(float d, float w) {
        return smoothstep(w, w * 0.35, d) + 0.35 * exp(-d / (w * 2.5));
    }

    // 擬似的な記号（3×5格子の画を乱数で点ける）
    float glyph(vec2 p, float id) {
        if (p.x < 0.0 || p.x > 1.0 || p.y < 0.0 || p.y > 1.0) return 0.0;
        vec2 g = p * vec2(3.0, 5.0);
        vec2 cell = floor(g);
        vec2 f = fract(g);
        float on = step(0.45, bdHash21(cell + id * 7.3));
        // 横画・縦画のどちらか
        float horiz = step(0.5, bdHash21(cell.yx + id * 3.1));
        float d = horiz > 0.5 ? abs(f.y - 0.5) : abs(f.x - 0.5);
        return on * tube(d * 0.2, 0.03);
    }

    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        vec2 uv = getUV0();
        float aspect = max(variable_attrs.x, 0.05);
        vec2 p = vec2(uv.x * aspect, uv.y);        // 縦横比を保った座標（高さ = 1）
        float t = materialParams.time;
        float seed = materialParams.seed;
        int pattern = int(materialParams.pattern + 0.5);
        vec3 col = materialParams.color;

        // 枠（すべてのパターン共通）
        vec2 edge = min(p, vec2(aspect, 1.0) - p);
        float frame = tube(min(edge.x, edge.y), 0.035);
        float glow = 0.0;
        vec3 second = bdNeon(fract(seed * 3.3 + 0.5));

        if (pattern == 0 || pattern == 4) {
            // 記号の列（横長なら横に、縦長なら縦に並べる）
            bool vertical = aspect < 1.0 || pattern == 4;
            float n = vertical ? max(1.0, floor(1.0 / aspect + 0.5)) : max(1.0, floor(aspect * 1.2));
            vec2 q = vertical ? vec2(uv.x, uv.y * n) : vec2(uv.x * n, uv.y);
            float id = floor(vertical ? q.y : q.x);
            vec2 f = fract(q);
            glow = glyph((f - 0.15) / 0.7, id + seed * 50.0);
        } else if (pattern == 1) {
            // 流れる横帯
            float bands = step(0.5, fract(p.y * 4.0)) * (0.5 + 0.5 * sin(p.x * 6.0 - t * 4.0));
            glow = bands * 0.8;
        } else if (pattern == 2) {
            // 同心円（脈動）
            vec2 c = vec2(aspect * 0.5, 0.5);
            float r = length(p - c);
            glow = tube(abs(fract(r * 4.0 - t * 0.6) - 0.5) * 0.25, 0.03);
        } else if (pattern == 3) {
            // 流れる山形
            float v = fract(p.x * 1.5 - abs(p.y - 0.5) * 1.5 - t * 0.8);
            glow = tube(abs(v - 0.5) * 0.3, 0.035);
        } else if (pattern == 5) {
            // LEDドット（波が走る）
            vec2 g = p * 18.0;
            vec2 f = fract(g) - 0.5;
            float wave = 0.5 + 0.5 * sin(floor(g.x) * 0.4 + floor(g.y) * 0.3 - t * 3.0);
            glow = smoothstep(0.35, 0.1, length(f)) * wave;
        } else if (pattern == 6) {
            // 二色の斜め縞
            float s = step(0.5, fract((p.x + p.y) * 2.5 + t * 0.2));
            col = mix(col, second, s);
            glow = 0.7;
        } else {
            // 切れかけのネオン管（区間ごとにちらつく）
            float seg = floor(p.x * 4.0);
            float dead = step(0.7, bdHash21(vec2(seg, seed * 91.0)));
            float flicker = step(0.3, fract(sin(t * 23.0 + seg * 7.0) * 43758.5));
            glow = tube(abs(p.y - 0.5) * 0.4, 0.03) * mix(1.0, flicker, dead);
        }

        // 全体のちらつき（まれに一瞬暗くなる）
        float blink = 1.0 - 0.6 * step(0.992, fract(sin(floor(t * 12.0) + seed * 311.0) * 43758.5453));
        vec3 panel = col * 0.035;                      // 消えている部分の地の色
        vec3 lightC = mix(col, vec3(1.0), 0.18);       // 芯は少し白飛び
        vec3 e = panel + lightC * (glow + frame * 0.9) * blink;
        material.baseColor = vec4(0.0, 0.0, 0.0, 1.0);
        material.emissive = vec4(e * materialParams.nits, 1.0);
    }
}
