// 蒸気（頂点属性なし描画）。マンホール・排気口から立ち上る柔らかい板。オーバードローが負荷の主役。
material {
    name : steam,
    shadingModel : unlit,
    parameters : [
        { type : float4[16], name : vents },
        { type : float, name : ventCount },
        { type : float3, name : tint },
        { type : float, name : nits },
        { type : float, name : time }
    ],
    variables : [ quad ],
    blending : transparent,
    depthWrite : false,
    culling : none,
    featureLevel : 1,
    variantFilter : [ skinning, shadowReceiver, vsm ]
}

vertex {
    #include "common.glsl"

    void materialVertex(inout MaterialVertexInputs material) {
        int vid = getVertexIndex();
        int pid = vid / 6;
        int corner = vid - pid * 6;
        float fp = float(pid);
        int nv = max(int(materialParams.ventCount + 0.5), 1);
        int v = pid - (pid / nv) * nv;
        vec4 vent = materialParams.vents[v];

        float life = 3.5 + 2.0 * bdHash11(fp * 0.37);
        float age = fract(materialParams.time / life + bdHash11(fp * 1.91));
        vec3 jitter = vec3(bdHash11(fp * 3.1) - 0.5, 0.0, bdHash11(fp * 5.3) - 0.5) * 2.2;
        float t = materialParams.time;
        // 立ち上がりながら渦を巻いて横へ流れる。1粒は小さく薄く、数で煙の形を作る
        vec3 swirl = vec3(sin(t * 0.9 + fp * 0.7) * 0.9, 0.0, cos(t * 0.6 + fp * 1.3) * 0.9) * age;
        vec3 pUser = vent.xyz + jitter * (0.15 + 0.5 * age) + vec3(0.0, age * (3.0 + 2.0 * vent.w), 0.0) + swirl
                   + vec3(1.6, 0.0, 0.6) * age * age;
        float size = mix(0.2, 1.4, sqrt(age)) * (0.7 + 0.6 * bdHash11(fp * 7.7));

        vec3 offset = getWorldCameraPosition() - (getUserWorldFromWorldMatrix() * vec4(getWorldCameraPosition(), 1.0)).xyz;
        vec3 p = pUser + offset;
        // カメラに向ける
        mat4 v2w = getWorldFromViewMatrix();
        vec3 right = v2w[0].xyz, up = v2w[1].xyz;
        vec2 q;
        if (corner == 0) q = vec2(-1.0, -1.0);
        else if (corner == 1) q = vec2(1.0, -1.0);
        else if (corner == 2) q = vec2(-1.0, 1.0);
        else if (corner == 3) q = vec2(1.0, -1.0);
        else if (corner == 4) q = vec2(1.0, 1.0);
        else q = vec2(-1.0, 1.0);
        material.worldPosition = vec4(p + (right * q.x + up * q.y) * size, 1.0);
        float alpha = smoothstep(0.0, 0.15, age) * (1.0 - smoothstep(0.45, 1.0, age)) * 0.075;
        material.quad = vec4(q, alpha, bdHash11(fp * 9.1));
    }
}

fragment {
    #include "common.glsl"

    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        vec2 q = variable_quad.xy;
        float r = length(q);
        float n = bdNoise2(q * 2.5 + variable_quad.w * 10.0 + materialParams.time * 0.2);
        float a = smoothstep(1.0, 0.1, r) * smoothstep(0.25, 0.75, n + 0.3 * (1.0 - r)) * variable_quad.z;
        vec3 c = materialParams.tint * materialParams.nits * getExposure();
        material.baseColor = vec4(c * a, a);
    }
}
